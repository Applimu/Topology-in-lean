import Topology.Sets
import Topology.Functions

structure Bornology (X: Type) where
  is_bounded: Set X → Prop
  /--
    Interestingly this could be stated as "`is_bounded` is anti-monotonic"
  -/
  subset_bounded (A B: Set X) (hAB: A ⊆ B): is_bounded B → is_bounded A
  union_bounded (A B: Set X): is_bounded A → is_bounded B → is_bounded (A ∪ B)
  singleton_bounded (x: X): is_bounded {x}


namespace Bornology

def trivial (X: Type): Bornology X where
  is_bounded _ := True
  subset_bounded _ _ _ _ := by trivial
  union_bounded _ _ _ _ := by trivial
  singleton_bounded _ := by trivial

def finite (X: Type): Bornology X where
  is_bounded S := ∀b: Bornology X, b.is_bounded S
  subset_bounded A B hAB hB := by
    intro b
    replace hB := hB b
    exact b.subset_bounded A B hAB hB
  union_bounded A B hA hB := by
    intro b
    specialize hA b
    specialize hB b
    exact b.union_bounded A B hA hB
  singleton_bounded x := by
    intro b
    exact b.singleton_bounded x

/--
  Every antisymmetric order has a bornology generated by intervals `[lb, ub]`
-/
def order {X: Type} (r: X → X → Prop) [inst: Std.Total r] [trans: Trans r r r]: Bornology X where
  is_bounded S := ∃lb ub, ∀s ∈ S, r lb s ∧ r s ub
  subset_bounded A B hAB hB := by
    obtain ⟨lb, ub, h⟩ := hB
    exists lb, ub
    intro s ha
    specialize h s (hAB ha)
    exact h
  union_bounded A B hA hB := by
    obtain ⟨lb₁, ub₁, hB⟩ := hB
    obtain ⟨lb₂, ub₂, hA⟩ := hA
    cases inst.total lb₁ lb₂ <;> cases inst.total ub₁ ub₂
    case inl.inl hle₁ hle₂ =>
      exists lb₁, ub₂
      rintro s (hsA | hsB)
      · specialize hA s hsA
        exact ⟨trans.trans hle₁ hA.left, hA.right⟩
      · specialize hB s hsB
        exact ⟨hB.left, trans.trans hB.right hle₂⟩
    case inl.inr hle₁ hle₂ =>
      exists lb₁, ub₁
      rintro s (hsA | hsB)
      · specialize hA s hsA
        exact ⟨trans.trans hle₁ hA.left, trans.trans hA.right hle₂⟩
      · specialize hB s hsB
        exact ⟨hB.left, hB.right⟩
    case inr.inl hle₁ hle₂ =>
      exists lb₂, ub₂
      rintro s (hsA | hsB)
      · specialize hA s hsA
        exact ⟨hA.left, hA.right⟩
      · specialize hB s hsB
        exact ⟨trans.trans hle₁ hB.left, trans.trans hB.right hle₂⟩
    case inr.inr hle₁ hle₂ =>
      exists lb₂, ub₁
      rintro s (hsA | hsB)
      · specialize hA s hsA
        exact ⟨hA.left, trans.trans hA.right hle₂⟩
      · specialize hB s hsB
        exact ⟨trans.trans hle₁ hB.left, hB.right⟩
  singleton_bounded x := by
    exists x, x
    intro s rfl
    (obtain (h | h) := inst.total x x) <;> exact ⟨h, h⟩

theorem empty_bounded (b: Bornology X) [nmt: Nonempty X]: b.is_bounded Set.empty := by
  obtain ⟨x⟩ := nmt
  apply b.subset_bounded _ {x}
  · exact Set.empty_subset {x}
  · exact b.singleton_bounded x

theorem list_bounded (b: Bornology X) (l: List X) [Nonempty X]: b.is_bounded l := by
  induction l
  · simp
    change b.is_bounded Set.empty
    exact b.empty_bounded
  case cons x xs ih =>
    simp [@Eq.comm _ _ x]
    change b.is_bounded ({x} ∪ xs)
    apply b.union_bounded
    · exact b.singleton_bounded x
    · exact ih

def generate (f: Set (Set X)): Bornology X where
  is_bounded s := ∀b: Bornology X, (∀sf ∈ f, b.is_bounded sf) → b.is_bounded s
  subset_bounded A B hAB hB := by
    intro b hf
    specialize hB b hf
    exact b.subset_bounded A B hAB hB
  union_bounded A B hA hB := by
    intro b hf
    specialize hA b hf
    specialize hB b hf
    exact b.union_bounded A B hA hB
  singleton_bounded x := by
    intro b hf
    exact b.singleton_bounded x

def IsLocallyBounded (bX: Bornology X) (bY: Bornology Y) (f: X → Y) : Prop := ∀s: Set X, bX.is_bounded s → bY.is_bounded (Set.image f s)

def IsBounded (bY: Bornology Y) (f: X → Y): Prop := bY.is_bounded (Set.full_image f)


theorem bounded_imp_locally_bounded (bX: Bornology X) (bY: Bornology Y) (f: X → Y): IsBounded bY f → IsLocallyBounded bX bY f := by
  intro h s hs
  apply bY.subset_bounded _ (Set.full_image f)
  · exact Set.image_subset_full_image f s
  · exact h

@[simp]
theorem image_singleton : Set.image f {x} = {f x} := by
  ext y
  simp
  exact eq_comm

@[simp]
theorem image_fst_product (hsy: Set.nonempty sy): Set.image Prod.fst (Set.product sx sy) = sx := by
  ext x
  simp
  intro _
  exact hsy

@[simp]
theorem image_snd_product (hsx: Set.nonempty sx): Set.image Prod.snd (Set.product sx sy) = sy := by
  ext x
  simp
  intro _
  exact hsx

@[simp]
theorem product_empty {sx: Set X} : Set.product (Y := Y) sx Set.empty = Set.empty := by
  ext x
  simp [Set.product]

@[simp]
theorem empty_product {sy: Set Y} : Set.product (X := X) Set.empty sy = Set.empty := by
  ext x
  simp [Set.product]


def initial (f: X → Y) (bY: Bornology Y): Bornology X where
  is_bounded s := bY.is_bounded $ Set.image f s
  subset_bounded A B hAB hB := by
    apply bY.subset_bounded (Set.image f A) (Set.image f B)
    · exact Set.image_monotone f A B hAB
    · exact hB
  union_bounded A B hA hB := by
    rw [Set.image_union]
    exact bY.union_bounded (Set.image f A) (Set.image f B) hA hB
  singleton_bounded x := by
    simp
    exact bY.singleton_bounded (f x)


def product {X Y} (bX: Bornology X) (bY: Bornology Y): Bornology (X × Y) := generate {
    elem s := ∃sx, bX.is_bounded sx ∧ ∃sy, bY.is_bounded sy ∧  s = Set.product sx sy
}

theorem fst_locally_bounded (bX: Bornology X) (bY: Bornology Y) : IsLocallyBounded (product bX bY) bX Prod.fst := by
  intro s hs

  simp [product, generate] at hs
  specialize hs (initial Prod.fst bX) ?_
  · intro sf sx hsx sy hsy rfl
    simp [initial]
    apply bX.subset_bounded _ sx ?_ hsx
    by_cases Set.nonempty sy
    case pos hy =>
      simp [hy]
    case neg hy =>
      simp at hy
      subst hy
      simp
  · exact hs

theorem snd_locally_bounded (bX: Bornology X) (bY: Bornology Y) : IsLocallyBounded (product bX bY) bY Prod.snd := by
  intro s hs

  simp [product, generate] at hs
  specialize hs (initial Prod.snd bY) ?_
  · intro sf sx hsx sy hsy rfl
    simp [initial]
    apply bY.subset_bounded _ sy ?_ hsy
    by_cases Set.nonempty sx
    case pos hx =>
      simp [hx]
    case neg hx =>
      simp at hx
      subst hx
      simp
  · exact hs

theorem product_universal_property (bX: Bornology X) (bY: Bornology Y) (bZ: Bornology Z) {f: Z → X} {g: Z → Y} (hf: IsLocallyBounded bZ bX f)
  (hg: IsLocallyBounded bZ bY g): IsLocallyBounded bZ (product bX bY) (fun z => (f z, g z)) := by
    intro sz hsz b hb
    simp at hb
    apply b.subset_bounded _ (Set.product (Set.image f sz) (Set.image g sz))
    · simp
      intro z hz
      simp
      constructor
      · exists z
      · exists z
    · refine hb (Set.product (Set.image f sz) (Set.image g sz)) (Set.image f sz) ?_ (Set.image g sz) ?_ rfl
      · apply hf
        exact hsz
      · apply hg
        exact hsz

def sum {X Y} (bX: Bornology X) (bY: Bornology Y): Bornology (X ⊕ Y) := generate {
  elem s := (∃sx: Set X, s = Set.image Sum.inl sx ∧ bX.is_bounded sx) ∨ (∃sy: Set Y, s = Set.image Sum.inr sy ∧ bY.is_bounded sy)
}

theorem inl_locally_bounded (bX: Bornology X) (bY: Bornology Y) : IsLocallyBounded bX (sum bX bY) Sum.inl := by
  intro sx hsx
  simp [sum, generate]
  intro b hb
  apply hb (Set.image Sum.inl sx)
  left
  exists sx


theorem inr_locally_bounded (bX: Bornology X) (bY: Bornology Y) : IsLocallyBounded bY (sum bX bY) Sum.inr := by
  intro sy hsy
  simp [sum, generate]
  intro b hb
  apply hb (Set.image Sum.inr sy)
  right
  exists sy

@[simp]
theorem Set.image_inl_union_image_inr {X Y} : Set.full_image (@Sum.inl X Y) ∪ Set.full_image (@Sum.inr X Y) = Set.all := by
  refine (Set.all_subset_iff (Set.full_image Sum.inl ∪ Set.full_image Sum.inr)).mp ?_
  intro xy
  simp
  cases xy
  case inl x =>
    left
    exists x
  case inr y =>
    right
    exists y

